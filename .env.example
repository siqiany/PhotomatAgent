# PhotoMatAgent environment template (copy to .env and fill in).
# Never commit .env: it contains private keys and API tokens.

# --- model providers -------------------------------------------------------
PHOTOMATAGENT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Materials Project -----------------------------------------------------
MATERIALS_API_KEY=

# --- SCNet HPC (SSH + Slurm) ----------------------------------------------
# Values (host/port/username/key) must come from ONE SCNet connection page
# (E-Shell > SSH connection); keys have a validity period.
SCNET_HOST=
SCNET_USERNAME=
SCNET_PORT=22
SCNET_PRIVATE_KEY_PATH=
SCNET_REMOTE_ROOT=~/myjob
SCNET_PARTITION=

SCNET_CONNECT_TIMEOUT_SECONDS=20
SCNET_TRANSFER_TIMEOUT_SECONDS=3600

# --- SCNet VASP ------------------------------------------------------------
SCNET_VASP_MODULE=vasp-5.4.4-ioptcell_intelmpi2017_hdf5_libxc
# SCNET_VASP_ENV_SCRIPT=/public/home/USER/apprepo/vasp/VERSION/scripts/env.sh
# Exact PBE library directory: $SCNET_VASP_PSP_DIR/<setup>/POTCAR
# SCNET_VASP_PSP_DIR=/public/home/USER/potpaw_PBE
# Local psp dir (contains potpaw_PBE/ or potpaw_PBE.64/)
# PMG_VASP_PSP_DIR=/local/path/to/psp

# --- SCNet Hefei-NAMD ------------------------------------------------------
SCNET_NAMD_MODULE=hefei_namd-dev-intempi2017
SCNET_NAMD_EXECUTABLE=hfnamd
# SCNET_NAMD_ENV_SCRIPT=/public/home/USER/apprepo/hefei_namd/VERSION/scripts/env.sh

# --- SCNet MAGUS -----------------------------------------------------------
# MAGUS installation root on SCNet (conda environment).
SCNET_MAGUS_ROOT=~/magus
# Optional: absolute path to the magus executable (auto-discovered otherwise)
# SCNET_MAGUS_EXECUTABLE=/public/home/USER/magus/bin/magus
# Optional: env script that activates the MAGUS python environment
# SCNET_MAGUS_ENV_SCRIPT=/path/to/magus_env.sh
# Optional: VASP environment INITIALIZATION script (module loads etc.) for
# MAGUS+VASP. This is NOT the ASE execution command -- see
# SCNET_MAGUS_ASE_VASP_COMMAND below.
# SCNET_MAGUS_VASP_SCRIPT=/public/home/USER/apprepo/vasp/VERSION/scripts/env.sh
# ASE VASP_PP_PATH: the PARENT directory containing potpaw_PBE/ (ASE appends
# potpaw_PBE/<setup>/POTCAR). NOT the same as SCNET_VASP_PSP_DIR.
SCNET_MAGUS_VASP_PP_PATH=/public/home/USER
# Actual VASP command ASE should invoke inside MAGUS (e.g.
# "srun --mpi=pmi2 vasp_std"). Must be verified on the user's SCNet
# environment before enabling MAGUS+VASP acceptance; leave empty until then.
# SCNET_MAGUS_ASE_VASP_COMMAND=srun --mpi=pmi2 vasp_std

# --- HPC submission gating (never auto-enable) -----------------------------
PHOTOMATAGENT_ALLOW_HPC_SUBMIT=0
PHOTOMATAGENT_HPC_MAX_NODES=1
PHOTOMATAGENT_HPC_MAX_TASKS_PER_NODE=64
PHOTOMATAGENT_HPC_MAX_WALLTIME_MINUTES=720
PHOTOMATAGENT_HPC_ALLOWED_PARTITIONS=kshcnormal

# --- conditional VAE composition generation ------------------------------
# Root containing jarvis_cvae_v1/checkpoint.pt and
# jarvis_inverse_v1/candidate_metadata.json. When omitted, PhotomatAgent also
# checks data/photoelectric_vae and a sibling GlassCrewAgent deployment.
# PHOTOMATAGENT_VAE_ASSET_ROOT=/path/to/data/photoelectric_vae
# Optional per-file overrides:
# VAE_CHECKPOINT_PATH=/path/to/checkpoint.pt
# VAE_METADATA_PATH=/path/to/candidate_metadata.json

# --- live test gating ------------------------------------------------------
# PHOTOMATAGENT_RUN_LIVE_SCIENCE=1     # read-only probes
# PHOTOMATAGENT_RUN_LIVE_MAGUS_VASP=1  # additional gate for MAGUS+VASP tests
